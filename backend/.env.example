DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/syncora
ASYNC_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/syncora
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173

# ===== LLM Provider =====
# "ollama" (LOCAL, free, runs on your GPU), "openai" (paid API), "mock" (offline/dev)
LLM_PROVIDER=ollama

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# ===== Ollama (LOCAL, no API costs) =====
# Install from: https://ollama.com/download/windows
# After install, pull the models (one-time downloads ~2-3GB total):
#   ollama pull llama3.2:3b
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ===== Local Whisper (Python package, runs on GPU/CPU) =====
WHISPER_USE_LOCAL=true
# tiny(75MB) / base(145MB) / small(460MB) / medium(1.5GB) / large-v3(3GB)
WHISPER_LOCAL_MODEL=small
# Leave empty = auto-detect CUDA GPU (otherwise CPU)
WHISPER_DEVICE=

CHROMA_PATH=./chroma_data
MAX_UPLOAD_MB=500
MEDIA_STORAGE_DIR=./media_storage
